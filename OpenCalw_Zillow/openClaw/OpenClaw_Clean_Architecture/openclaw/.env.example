# Copiar a .env y completar. Nunca commitear el .env real.
APP_ENV=dev
APP_VERSION=0.2.0
LOG_LEVEL=INFO
LOG_JSON=true

# Redis
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_DB=0
REDIS_STREAM_SCRAPING=openclaw_scraping_queue
REDIS_CONSUMER_GROUP=scrapers
REDIS_CONSUMER_NAME=worker-1

# Firecrawl (obligatorio para operar)
FIRECRAWL_API_KEY=

# API key de ingesta (obligatoria en prod)
OPENCLAW_API_KEY=

# Telegram
TG_TOKEN=
TG_CHAT_ID=

# Servicio de liquidez externo. BUY_MODE: disabled | sandbox
UAO_SCALPING_API=http://uao-scalping-core:8001/v1/liquidity
BUY_MODE=disabled

# PostgreSQL (se usa a partir del sprint 2)
DATABASE_URL=postgresql+asyncpg://openclaw:openclaw@postgres:5432/openclaw
POSTGRES_USER=openclaw
POSTGRES_PASSWORD=openclaw
POSTGRES_DB=openclaw
