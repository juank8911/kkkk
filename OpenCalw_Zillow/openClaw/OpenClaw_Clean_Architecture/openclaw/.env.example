# Copiar a .env y completar. Nunca commitear el .env real.
APP_ENV=dev
APP_VERSION=0.2.0
LOG_LEVEL=INFO
LOG_JSON=true

# Redis
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_DB=0
REDIS_STREAM_SCRAPING=openclaw_scraping_queue
REDIS_CONSUMER_GROUP=scrapers
REDIS_CONSUMER_NAME=worker-1

# Firecrawl (obligatorio para operar)
FIRECRAWL_API_KEY=

# Ollama remoto para separar anuncios en viviendas estructuradas
OLLAMA_BASE_URL=https://resuciter.jeikeisolutions.com/ollama
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SEGUNDOS=300

# API key de ingesta (obligatoria en prod)
# API key tactica (obligatoria en prod). El cliente la envia en la cabecera
# X-OpenClaw-Tactical-Key. El servicio solo compara su SHA-256.
OPENCLAW_API_KEY=
# Alternativa recomendada en produccion: huella SHA-256 precomputada
# (printf '%s' "$CLAVE" | sha256sum). Si se informa, tiene prioridad.
OPENCLAW_API_KEY_SHA256=

# Telegram
TG_TOKEN=
TG_CHAT_ID=
# secret_token que Telegram envia en la cabecera X-Telegram-Bot-Api-Secret-Token.
# Obligatorio en produccion: sin el, el webhook responde 503.
TG_WEBHOOK_SECRET=
# Allowlist de chats autorizados a lanzar comandos (CSV). Vacia = sin restriccion.
TG_ALLOWED_CHAT_IDS=
# Segundos que se recuerda un update_id para no procesarlo dos veces.
TG_DEDUPE_TTL_SEGUNDOS=3600

# Estrategia de negociacion Seller Financing (EE. UU. en ingles) y reporte diario 11:00 AM
NEGOTIATION_LANGUAGE=en-US
NEGOTIATION_DOWN_PAYMENT_MIN_USD=5000
NEGOTIATION_DOWN_PAYMENT_MAX_USD=7000
NEGOTIATION_BONUS_EXTRA_MONTHS=6
NEGOTIATION_REPORT_HOUR=11
NEGOTIATION_REPORT_MINUTE=0
NEGOTIATION_REPORT_TZ=America/New_York

# Servicio de liquidez externo. BUY_MODE: disabled | sandbox
UAO_SCALPING_API=http://uao-scalping-core:8001/v1/liquidity
BUY_MODE=disabled

# PostgreSQL (se usa a partir del sprint 2)
DATABASE_URL=postgresql+asyncpg://openclaw:openclaw@postgres:5432/openclaw
POSTGRES_USER=openclaw
POSTGRES_PASSWORD=openclaw
POSTGRES_DB=openclaw
